{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": ["bun"],
    "paths": {
      "kitsu": ["./packages/kitsu/src/index.ts"],
      "kitsu-core": ["./packages/kitsu-core/src/index.ts"]
    }
  },
  "include": [
    "packages/**/src/**/*.ts",
    "specification/**/*.ts",
    "scripts/**/*.ts",
    "release.config.ts"
  ],
  "exclude": ["node_modules", ".cache", "**/dist", "**/types"]
}
